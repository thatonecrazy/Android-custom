<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Veneer" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- The home screen: a see-through window over the system wallpaper. -->
    <style name="Theme.Veneer.Launcher">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Customize also shows the wallpaper, so the live preview sits on the real background. -->
    <style name="Theme.Veneer.Customize">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
